# Research New — Environment Configuration
# 다중 키워드: 세미콜론(;) 또는 쉼표(,)로 구분
# 예: RESEARCH_TOPIC=Cancer Immunotherapy; Tumor Microenvironment
RESEARCH_TOPIC=autism&macrophage;lipids&inflammation;maternal immune activation

# 주의: RESEARCH_MAX_RESULTS는 "소스×키워드별" 후보 수집 단위값.
# 최종 선발은 RESEARCH_MAX_PAPERS_PER_KEYWORD(기본 5)가 제어:
#   키워드별 저널 IF 우선 상위 N건 선출, 검색 실패/미달 키워드 몫은 잔여 풀에서 재배분.
RESEARCH_MAX_RESULTS=25
RESEARCH_LOOKBACK_DAYS=1

# 키워드당 최종 선발 편수 (기본 5). 총량 = N × 키워드 수
# RESEARCH_MAX_PAPERS_PER_KEYWORD=5
# 안전망 절대 상한 (기본 30)
# RESEARCH_MAX_TOTAL_PAPERS=30

# LLM 요약 시간 예산(초)과 편수 상한 — 크론 예산 보호용 (선택)
# RESEARCH_TIME_BUDGET_SECS=7200
# RESEARCH_MAX_TOTAL_PAPERS=12
# LLM 요청 타임아웃/재시도 (선택)
# LLM_TIMEOUT_SECS=1800
# LLM_MAX_RETRIES=3

# Local LLM: GLM-5.2 (CPU 기반, llm-chat.example.local:8888)
LOCAL_LLM_URL=http://llm-chat.example.local:8888
# Vision LLM: Qwen2.5-VL-72B (llm-vision.example.local:8888)
VISION_LLM_URL=http://llm-vision.example.local:8888   # 미사용 (서버 500 오류로 비활성화)
LLM_MODEL=

# ⚠️ 아래 값들은 모두 placeholder입니다. 실제 키를 커밋하지 마세요.
# Springer Nature Open Access API (500 Hits/Day, 100 Hits/Min)
SPRINGER_API_KEY=your_springer_api_key_here

# Elsevier ScienceDirect Search API V2 (100 Hits/Min)
# 초록은 STANDARD view에 없어 자동 보강: Abstract Retrieval(META) → Crossref → OpenAlex
ELSEVIER_API_KEY=your_elsevier_api_key_here
# 기관 프록시/원격 접근 시에만 필요 (선택)
# ELSEVIER_INST_TOKEN=your_institution_token_here
# 초록 보강 비활성화 (선택)
# ELSEVIER_SKIP_ABSTRACT_ENRICH=1

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_CHANNEL=C0XXXXXXXXXX
SLACK_BOT_NAME=Research Bot
